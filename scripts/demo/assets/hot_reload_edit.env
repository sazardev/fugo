# Three live edits to ui/home.go (the mobile-style scaffold — see
# assets/mobile_home.go.tmpl), done for real in nvim during the recording
# (search -> `0C` change-to-end-of-line -> type the replacement -> Escape
# -> :w), each one triggering a real hot-reload rebuild. `0C` (not
# `cc`/`S`) is used deliberately: it does NOT re-apply autoindent, so the
# replacement's own leading tabs are what actually land — correct
# regardless of the machine's nvim indent settings.
#
# EDIT_1: a 4th default task appears in the list on save.
EDIT1_SEARCH='tasks := []string{"Diseñar el logo", "Conectar el backend", "Grabar el demo"}'
EDIT1_NEW='	tasks := []string{"Diseñar el logo", "Conectar el backend", "Grabar el demo", "🔥 Agregada con hot reload"}'

# EDIT_2: a real logic change, not just cosmetic — the FAB's new-task label.
EDIT2_SEARCH='tasks = append(tasks, fmt.Sprintf("Nueva tarea #%d", len(tasks)+1))'
EDIT2_NEW='		tasks = append(tasks, fmt.Sprintf("✨ Tarea instantánea #%d", len(tasks)+1))'

# EDIT_3: restyle the Profile tab's tagline — same fg.Theme tokens, live.
EDIT3_SEARCH='fg.Text("built with Fugo").Color(t.Colors.Muted),'
EDIT3_NEW='			fg.Text("✨ editado en vivo — built with Fugo").Color(t.Colors.Success),'
