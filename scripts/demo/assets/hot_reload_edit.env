# Three live edits to ui/home.go, done for real in nvim during the
# recording (search -> `0C` change-to-end-of-line -> type the replacement
# -> Escape -> :w), each one triggering a real hot-reload rebuild. `0C`
# (not `cc`/`S`) is used deliberately: it does NOT re-apply autoindent,
# so the replacement's own leading tabs are what actually land — correct
# regardless of the machine's nvim indent settings.
#
# EDIT_1: add a tagline to the Home page's returned widget tree.
EDIT1_SEARCH='return page(t, "Home", count, fg.SizedBox(0, t.Spacing.MD), inc, fg.SizedBox(0, t.Spacing.SM), about)'
EDIT1_NEW='	return page(t, "Home", count, fg.SizedBox(0, t.Spacing.MD), inc, fg.SizedBox(0, t.Spacing.SM), about, fg.SizedBox(0, t.Spacing.SM), fg.Text("🔥 hot reload — zero rebuild wait").Color(t.Colors.Success))'

# EDIT_2: a real logic change, not just cosmetic — Increment now adds 2.
EDIT2_SEARCH='counter++'
EDIT2_NEW='			counter += 2'

# EDIT_3: restyle the About page's body text — same fg.Theme tokens, live.
EDIT3_SEARCH='fg.Text("Built with Fugo — Go drives logic, Flutter renders.").Color(t.Colors.Muted),'
EDIT3_NEW='		fg.Text("✨ editado en vivo — Go compila, Flutter refresca al instante.").Color(t.Colors.Success),'
